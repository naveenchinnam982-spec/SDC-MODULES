<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_graph"
    app:startDestination="@id/settingsHomeFragment">

    <fragment
        android:id="@+id/settingsHomeFragment"
        android:name="project.module_3handson1.SettingsHomeFragment"
        android:label="Settings Home">
        <action
            android:id="@+id/action_settingsHomeFragment_to_profileDetailFragment"
            app:destination="@id/profileDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileDetailFragment"
        android:name="project.module_3handson1.ProfileDetailFragment"
        android:label="Profile Detail">
        <argument
            android:name="userId"
            app:argType="string" />
        <deepLink
            android:id="@+id/deepLink"
            app:uri="www.example.com/profile/{userId}" />
    </fragment>
</navigation>